# Copy this file to .env and customise as needed.
# docker compose reads .env automatically.

# Kafka broker address (inside the compose network)
KAFKA_BROKERS=kafka:9092

# OTLP gRPC endpoint for all three services
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317

# Inventory gRPC address as seen by the Order Service
INVENTORY_GRPC_ADDR=inventory-service:9090

# Prefix that forces inventory reservation failure (compensation path demo).
# Set to empty string to disable forced failures.
INVENTORY_FAIL_ITEM_PREFIX=FAIL_
