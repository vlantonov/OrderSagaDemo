{
  "id": null,
  "uid": "saga-overview",
  "title": "Saga Overview",
  "tags": ["ordersagademo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" },
    { "type": "datasource", "id": "tempo",      "name": "Tempo",      "version": "1.0.0" }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Order Throughput (rpm)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(saga_orders_total[1m]) * 60",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Compensation Counter",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(saga_compensation_total[5m]))",
          "legendFormat": "compensations/5m"
        }
      ]
    },
    {
      "id": 3,
      "title": "Saga Step Latency p99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(saga_step_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka Messages Produced (rpm)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(kafka_messages_produced_total[1m]) * 60",
          "legendFormat": "{{ topic }}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Service Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "uid": "loki-uid", "type": "loki" },
      "targets": [
        {
          "expr": "{job=~\"order-service|payment-service|inventory-service\"}"
        }
      ]
    }
  ],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {}
}
