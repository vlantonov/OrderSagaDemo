{
  "id": null,
  "uid": "slo-dashboard",
  "title": "SLO Dashboard — Order Success Rate",
  "tags": ["ordersagademo", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Order Success Rate (SLO: 95%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "minVizHeight": 75,
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.90 },
              { "color": "green",  "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(saga_orders_total{status=\"completed\"}[5m])) / (sum(rate(saga_orders_total[5m])) + 0.001)",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Budget Remaining (SLO window: 30m)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "clamp_min(0.05 - (1 - sum(rate(saga_orders_total{status=\"completed\"}[30m])) / (sum(rate(saga_orders_total[30m])) + 0.001)), 0)",
          "legendFormat": "error budget remaining"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      }
    },
    {
      "id": 3,
      "title": "Orders by Status (last 5m)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (increase(saga_orders_total[5m]))",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Compensation Rate Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus-uid", "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(saga_compensation_total[5m])",
          "legendFormat": "{{ reason }}"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {}
}
